{
  "name": "SQLPad",
  "description": "Write and run SQL queries in the browser, and chart the results.",
  "category": "Databases",
  "website": "https://getsqlpad.com",
  "color": "#2C3E50",
  "fullColorLogo": true,
  "note": "Sign in with the admin email and password shown here, then add a connection to your database.",
  "expose": {
    "service": "sqlpad",
    "port": 3000
  },
  "vars": [
    {
      "key": "SQLPAD_ADMIN",
      "value": "admin@example.com",
      "label": "Admin email"
    },
    {
      "key": "SQLPAD_ADMIN_PASSWORD",
      "generate": "password",
      "label": "Admin password"
    },
    {
      "key": "SQLPAD_SECRET",
      "generate": "secret"
    },
    {
      "key": "SQLPAD_URL",
      "publicUrl": true
    }
  ]
}
