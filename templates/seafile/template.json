{
  "name": "Seafile",
  "description": "File sync and share with desktop and mobile clients.",
  "category": "Storage",
  "website": "https://www.seafile.com",
  "color": "#FF9800",
  "note": "Sign in with the admin email and the generated admin password (Variables tab).",
  "expose": {
    "service": "seafile",
    "port": 80
  },
  "vars": [
    {
      "key": "SEAFILE_SERVER_HOSTNAME",
      "publicHost": true
    },
    {
      "key": "ADMIN_EMAIL",
      "value": "admin@example.com",
      "label": "Admin email"
    },
    {
      "key": "ADMIN_PASSWORD",
      "generate": "password",
      "label": "Admin password"
    },
    {
      "key": "JWT_PRIVATE_KEY",
      "generate": "secret"
    },
    {
      "key": "DB_ROOT_PASSWORD",
      "generate": "password"
    },
    {
      "key": "DB_PASSWORD",
      "generate": "password"
    }
  ]
}
