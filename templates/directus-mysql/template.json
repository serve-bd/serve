{
  "name": "Directus (MySQL)",
  "description": "Headless CMS and instant REST/GraphQL API, with MySQL.",
  "category": "CMS",
  "website": "https://directus.io",
  "color": "#263238",
  "expose": {
    "service": "directus",
    "port": 8055
  },
  "vars": [
    {
      "key": "SECRET",
      "generate": "secret"
    },
    {
      "key": "DB_PASSWORD",
      "generate": "password"
    },
    {
      "key": "ADMIN_EMAIL",
      "value": "admin@example.com",
      "label": "Admin email"
    },
    {
      "key": "ADMIN_PASSWORD",
      "generate": "password",
      "label": "Admin password"
    },
    {
      "key": "PUBLIC_URL",
      "publicUrl": true
    }
  ]
}
