# Postgres connection string for Serve's own database
DATABASE_URL=postgres://serve:serve@localhost:5436/serve
# Random 32+ byte secret for sessions (openssl rand -hex 32)
BETTER_AUTH_SECRET=
# Public URL of the dashboard
BETTER_AUTH_URL=http://localhost:3000
# Key used to encrypt secrets at rest (openssl rand -hex 32)
SERVE_ENCRYPTION_KEY=
# Where Serve keeps repos, configs, certificates and backups (absolute host path)
SERVE_DATA_DIR=/data/serve
# Ports the nginx proxy binds on the host
SERVE_PROXY_HTTP_PORT=80
SERVE_PROXY_HTTPS_PORT=443
# Where the proxy reaches the dashboard (container:port)
SERVE_DASHBOARD_UPSTREAM=serve:3000
