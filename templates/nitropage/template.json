{
  "name": "Nitropage",
  "description": "Visual page builder for websites made from reusable building blocks.",
  "category": "CMS",
  "website": "https://nitropage.org",
  "color": "#0F172A",
  "note": "Open /admin on the domain to create the first admin account.",
  "expose": {
    "service": "nitropage",
    "port": 3000
  },
  "vars": [
    {
      "key": "POSTGRES_PASSWORD",
      "generate": "password"
    },
    {
      "key": "NP_AUTH_SALT",
      "generate": "hex32"
    },
    {
      "key": "NP_AUTH_PASSWORD",
      "generate": "secret"
    }
  ]
}
