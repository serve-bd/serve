{
  "name": "Redis Commander",
  "description": "Redis with a web interface to browse and edit keys.",
  "category": "Databases",
  "website": "https://github.com/joeferner/redis-commander",
  "color": "#FF4438",
  "note": "Sign in with the username and password shown here.",
  "expose": {
    "service": "redis-commander",
    "port": 8081
  },
  "vars": [
    {
      "key": "REDIS_PASSWORD",
      "generate": "password"
    },
    {
      "key": "HTTP_USER",
      "value": "admin",
      "label": "Login username"
    },
    {
      "key": "HTTP_PASSWORD",
      "generate": "password",
      "label": "Login password"
    }
  ]
}
