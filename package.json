{
  "name": "serve",
  "version": "0.1.18",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch --clear-screen=false src/worker/index.ts",
    "build": "next build && pnpm build:worker",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/worker.cjs --external:cpu-features --external:*.node --log-level=warning",
    "build:agent": "cd agent && for arch in amd64 arm64; do CGO_ENABLED=0 GOOS=linux GOARCH=$arch go build -trimpath -ldflags \"-s -w -X main.version=dev\" -o ../dist/agent/serve-agent-linux-$arch . || exit 1; done",
    "start": "next start",
    "worker": "node dist/worker.cjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "templates:build": "tsx scripts/templates.ts",
    "templates:check": "tsx scripts/templates.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@bprogress/next": "^3.2.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@dagrejs/dagre": "^3.1.1",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.10.1",
    "date-fns": "^4.4.0",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.12",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.30.0",
    "ssh2": "^1.17.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.6",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.5.0"
}
