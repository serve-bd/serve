{
  "name": "LibreChat",
  "description": "Chat interface for OpenAI, Anthropic, Google and other AI models.",
  "category": "AI",
  "website": "https://www.librechat.ai",
  "color": "#0F766E",
  "fullColorLogo": true,
  "minVersion": "0.1.9",
  "note": "Register the first account on the sign-up page. Leave the API keys empty to let each user enter their own key in the chat.",
  "expose": {
    "service": "librechat",
    "port": 3080
  },
  "vars": [
    {
      "key": "APP_URL",
      "publicUrl": true
    },
    {
      "key": "CREDS_KEY",
      "generate": "hex32"
    },
    {
      "key": "CREDS_IV",
      "generate": "hex16"
    },
    {
      "key": "JWT_SECRET",
      "generate": "hex32"
    },
    {
      "key": "JWT_REFRESH_SECRET",
      "generate": "hex32"
    },
    {
      "key": "OPENAI_API_KEY",
      "value": "",
      "label": "OpenAI API key (optional)"
    },
    {
      "key": "ANTHROPIC_API_KEY",
      "value": "",
      "label": "Anthropic API key (optional)"
    },
    {
      "key": "GOOGLE_KEY",
      "value": "",
      "label": "Google AI API key (optional)"
    }
  ]
}
