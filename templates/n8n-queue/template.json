{
  "name": "n8n (queue mode)",
  "description": "Workflow automation in queue mode: a main instance and a worker, with PostgreSQL and Redis.",
  "category": "Automation",
  "website": "https://n8n.io",
  "color": "#EA4B71",
  "expose": {
    "service": "n8n",
    "port": 5678
  },
  "vars": [
    {
      "key": "N8N_ENCRYPTION_KEY",
      "generate": "secret"
    },
    {
      "key": "DB_PASSWORD",
      "generate": "password"
    },
    {
      "key": "WEBHOOK_URL",
      "publicUrl": true
    }
  ]
}
